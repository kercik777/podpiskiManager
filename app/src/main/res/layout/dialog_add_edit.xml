<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
    <TextView android:id="@+id/dialog_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" android:layout_marginBottom="20dp" />
    <TextView android:id="@+id/label_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="6dp" android:paddingStart="4dp" />
    <EditText android:id="@+id/et_name" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_input_field" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:textSize="15sp" android:paddingStart="16dp" android:paddingEnd="16dp" android:singleLine="true" android:inputType="text" />
    <TextView android:id="@+id/tv_name_error" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/error" android:textSize="12sp" android:paddingStart="4dp" android:layout_marginTop="4dp" android:visibility="gone" />
    <LinearLayout android:id="@+id/link_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <TextView android:id="@+id/label_link" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/hint_link" android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginTop="16dp" android:layout_marginBottom="6dp" android:paddingStart="4dp" />
        <EditText android:id="@+id/et_link" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_input_field" android:textColor="@color/text_primary" android:textColorHint="@color/text_hint" android:textSize="15sp" android:paddingStart="16dp" android:paddingEnd="16dp" android:singleLine="true" android:inputType="textUri" />
        <TextView android:id="@+id/tv_link_error" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/error" android:textSize="12sp" android:paddingStart="4dp" android:layout_marginTop="4dp" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="24dp" android:gravity="end">
        <TextView android:id="@+id/btn_cancel" android:layout_width="wrap_content" android:layout_height="42dp" android:gravity="center" android:paddingStart="20dp" android:paddingEnd="20dp" android:text="@string/btn_cancel" android:textColor="@color/text_secondary" android:textSize="14sp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/btn_confirm" android:layout_width="wrap_content" android:layout_height="42dp" android:gravity="center" android:paddingStart="24dp" android:paddingEnd="24dp" android:layout_marginStart="8dp" android:text="@string/btn_add" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" android:background="@drawable/bg_button_primary" android:clickable="true" android:focusable="true" />
    </LinearLayout>
</LinearLayout>
